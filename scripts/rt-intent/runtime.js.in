// Generated by scripts/rt-intent/train.py with Google BERT-Tiny input embeddings.
// See THIRD_PARTY_NOTICES.md. Input is a transcript, never a microphone stream.
(function (root) {
  'use strict';
  const model = /* MODEL */;
  const numeric = new Set(model.numeric);
  const display = {
    'heading-turn': 'Heading change', 'heading-report': 'Heading report',
    'range-report': 'Range report', 'df-transmission': 'D/F transmission', standby: 'Stand by'
  };
  function classify(text) {
    if (typeof text !== 'string' || !text.length || text.length > 320) return null;
    const words = text.toLowerCase().match(/[a-z]+|[0-9]+/g) || [];
    const scores = model.bias.map(() => 0);
    let previous, count = 0, known = 0;
    for (const word of words) {
      const key = numeric.has(word) || /^\d+$/.test(word) ? 'number' : word;
      if (key === 'number' && key === previous) continue;
      previous = key;
      count += 1;
      if (!Object.hasOwn(model.tokens, key)) continue;
      known += 1;
      model.tokens[key].forEach((value, i) => { scores[i] += value; });
    }
    if (!known) return null;
    const logits = scores.map((sum, i) => sum / count + model.bias[i]);
    const top = Math.max(...logits);
    const probability = 1 / logits.reduce((sum, value) => sum + Math.exp(value - top), 0);
    const intent = model.labels[logits.indexOf(top)];
    if (probability < 0.65 || !Object.hasOwn(display, intent)) return null;
    return { intent, label: display[intent], score: probability };
  }
  root.ATSRadioIntent = Object.freeze({ classify });
  if (typeof module === 'object' && module.exports) module.exports = root.ATSRadioIntent;
})(globalThis);
